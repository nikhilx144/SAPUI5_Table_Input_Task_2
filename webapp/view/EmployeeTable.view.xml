<mvc:View 
    controllerName="input.in.table.row.tasks.ui5.ui5inputintablerowtask2.controller.EmployeeTable"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:p13n="sap.m.p13n"
    xmlns:app="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">
    <Page id="employeeTablePage" showHeader="false" showSubHeader="false">
        <core:Fragment fragmentName="input.in.table.row.tasks.ui5.ui5inputintablerowtask2.view.fragments.TopBar" type="XML"/>
        <content>
            <fb:FilterBar id="filterBar" search=".onSearch" header="{i18n>candidateTableFilterBarHeading}" visible="true">
                <fb:filterGroupItems>
                    <fb:FilterGroupItem 
                        id="jobIdFilterGroupItem"
                        visibleInFilterBar="true"
                        name="jobId"
                        label="Job ID"
                        groupName="Group1">
                        <fb:control>
                            <Input id="jobIdSearchField" width="100%"/>
                        </fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem 
                        id="candidateIdFilterGroupItem"
                        visibleInFilterBar="true"
                        name="candidateId"
                        label="Candidate ID"
                        groupName="Group1">
                        <fb:control>
                            <Input id="candidateIdSearchField"/>
                        </fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem 
                        id="workLocationFilterGroupItem"
                        visibleInFilterBar="true"
                        name="workLocation"
                        label="Work Location"
                        groupName="Group1">
                        <fb:control>
                            <Input id="workLocationSearchField"/>
                        </fb:control>
                    </fb:FilterGroupItem>
                    <fb:FilterGroupItem 
                        id="skillsFilterGroupItem"
                        visibleInFilterBar="true"
                        name="skills"
                        label="Skills"
                        groupName="Group1">
                        <fb:control>
                            <Input id="skillsSearchField"/>
                        </fb:control>
                    </fb:FilterGroupItem>
                </fb:filterGroupItems>
            </fb:FilterBar>

            <Table 
                id="candidateTable" 
                width="auto"
                items="{
                    path: 'jobApplicants>/Table',
                    templateShareable: false
                }">
                <headerToolbar>
                    <Toolbar id="tableHeaderToolbar">
                        <Title id="candidateTableTitle" text="{i18n>candidateTableTitle}"/>
                        <ToolbarSpacer id="toolBarSpacer"/>
                        <Button id="formPageNavButton" icon="sap-icon://form" text="Add Employee Details" press="onEmpDetailFormNavButtonPress" />
                        <Button id="addRowButton" icon="sap-icon://add" text="Add Row" press=".onAddRow"/>
                        <Button id="employeesButton" icon="sap-icon://employee" text="Employees" press=".onEmpButtonPress"/>
                    </Toolbar>
                </headerToolbar>
                <columns>
                    <Column id="serialNumberColumn" app:p13nKey="serialNumber_col">
                        <Text id="serialNumberColHeader" text="Serial Number"/>
                    </Column>

                    <Column id="jobCodeColumn" app:p13nKey="jobCode_col">
                        <Text id="jobCodeColHeader" text="Job Code"/>
                    </Column>

                    <Column id="candidateIdColumn" app:p13nKey="candidateId_col">
                        <Text id="candidateIdColHeader" text="Candidate ID"/>
                    </Column>

                    <Column id="workLocationColumn" app:p13nKey="workLocation_col">
                        <Text id="workLocationColHeader" text="Work Location"/>
                    </Column>

                    <Column id="skillsColumn" app:p13nKey="skills_col">
                        <Text id="skillsColHeader" text="Skills"/>
                    </Column>

                    <Column id="colControlsColumn" app:p13nKey="colControls_col">
                        <Text id="colControlsColHeader" text="Column Controls"/>
                    </Column>
                </columns>
                <items>
                    <ColumnListItem id="columnListItem" press=".onRowPress" type="Navigation">
                        <cells>
                            <Text id="serialNumberCell" text="{jobApplicants>serialNumber}"/>
                            <ComboBox 
                                id="jobCodeCell" 
                                editable="{jobApplicants>editableJobCode}"
                                selectedKey="{jobApplicants>jobCode}"
                                change=".onJobCodeChange">
                                <items>
                                    <core:ListItem id="j12ListItem" key="J12" text="J12"/>
                                    <core:ListItem id="j34ListItem" key="J34" text="J34"/>
                                </items>
                            </ComboBox>
                            <Input 
                                id="candidateIdCell" 
                                value="{jobApplicants>candidateId}" 
                                editable="{jobApplicants>editableCandidateId}"
                                valueHelpRequest=".onSelectDialogRequested"
                                showValueHelp="true"
                                change=".onCandidateIdChange" />
                            <Input 
                                id="workLocationCell" 
                                value="{jobApplicants>workLocation}" 
                                editable="{jobApplicants>editableWorkLocation}"
                                valueHelpRequest=".onSelectDialogRequested"
                                showValueHelp="true"
                                change=".onWorkLocationChange" />
                            <MultiComboBox 
                                id="skillsCell"
                                selectionChange=".onSkillsChange"
                                editable="{jobApplicants>editableSkills}"
                                selectedKeys="{jobApplicants>skills}"
                                items="{
                                    path: 'jobApplicants>/uniqueSkills'
                                }">
                                <core:ListItem id="skillsCellListItem" key="{jobApplicants>skill}" text="{jobApplicants>skill}"/>
                            </MultiComboBox>
                            <HBox id="colControlButtonsCell">
                                <Button id="deleteButton" press=".onDeleteRow" icon="sap-icon://delete"/>
                                <Button id="editButton" press=".onEditRow" icon="sap-icon://edit" visible="{jobApplicants>editButtonVisible}"/>
                            </HBox>
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
            <Button id="saveBtn" text="Save" press=".onSave" class="sapUiTinyMarginTop sapUiTinyMarginRight" visible="false"/>
            <Button id="cancelBtn" text="Cancel" press=".onCancel" class="sapUiTinyMarginTop  sapUiTinyMarginLeft" visible="false"/>
        </content>
    </Page>
</mvc:View>