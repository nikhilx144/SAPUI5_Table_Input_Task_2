<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<SelectDialog
		id="mySelectDialog"
		noDataText="{i18n>selectDialogNoDataText}"
		title="{i18n>selectDialogTitle}"
		confirm=".onSelectDialogConfirm"
		cancel=".onSelectDialogCancel"
		selectionChange=".onSelectionChange"
		items="{
			path: 'jobApplicants>/activeDialogItems'
		}">
		<StandardListItem
			id="selectDialogFragmentStandardListItem"
			title="{jobApplicants>title}"
			description="{jobApplicants>description}" />
	</SelectDialog>
</core:FragmentDefinition>