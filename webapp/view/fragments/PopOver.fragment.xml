<core:FragmentDefinition 
	xmlns:tnt="sap.tnt"
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
    <Popover
        id="myPopover"
        title="Employee Details"
        placement="Left">
        <Table 
            id="popOverEmpTable"
            items="{
                path: 'employees>/employees',
                templateShareable: false
            }">
            <columns>
                <Column id="idColumn">
                    <Label id="idLabel" text="ID"/>
                </Column>
                <Column id="nameColumn">
                    <Label id="nameLabel" text="Name"/>
                </Column>
            </columns>
            <items>
                <ColumnListItem id="popOverEmpTableColumnListItem">
                    <cells>
                        <Text id="idText" text="{employees>empId}"/>
                        <Text id="nameText" text="{employees>empName}"/>
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
	</Popover>
</core:FragmentDefinition>